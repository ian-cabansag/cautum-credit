# Optional: AI credit memo. The complete deterministic analysis runs without a key.
# Course key: PORTKEY_API_KEY=<your key> ; model gpt-6-luna only.
PORTKEY_API_KEY=
# Alternative: use your own OpenAI key; do NOT supply both keys.
OPENAI_API_KEY=
# Course key only: check your organization's Portkey gateway configuration.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-6-luna
OPENAI_MODEL=gpt-6-astra
# Optional number of AI memo calls allowed per server process (0 disables).
MAX_AI_CALLS=25
# Optional price card. Leave blank until exact provider/model prices are verified.
# JSON keys: provider, model, input, cached_input, output (USD / million), source_url, verified_on.
# The app never invents a price and does not verify the operator's cited publication.
AI_RATE_CARD_JSON=
